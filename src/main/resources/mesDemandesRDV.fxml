<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="25" styleClass="main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.DemandesRdvController">

    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="🔔 Demandes de rendez-vous" styleClass="header-title" />
            <Label fx:id="lblCount" text="X demande(s) en attente de votre réponse." styleClass="text-muted" />
        </VBox>
        <Button text="📅 Mes créneaux" onAction="#handleGoToDispos" styleClass="btn-outline-pill-sm" />
    </HBox>

    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <VBox fx:id="demandesTableContainer"
              styleClass="white-card-container"
              HBox.hgrow="ALWAYS"
              maxWidth="1000"
              alignment="CENTER">

            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

            <TableView fx:id="tableDemandes" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="130" />
                    <TableColumn fx:id="colHeure" text="Heure" prefWidth="130" />
                    <TableColumn fx:id="colPatient" text="Patient" prefWidth="180" />
                    <TableColumn fx:id="colMotif" text="Motif" prefWidth="220" />
                    <TableColumn fx:id="colPriorite" text="Priorité IA" prefWidth="130" />
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="180" />
                </columns>
            </TableView>

            <VBox fx:id="emptyState" alignment="CENTER" spacing="15" visible="false" managed="false">
                <Label text="📥" style="-fx-font-size: 50;" />
                <Label text="Aucune demande en attente" styleClass="header-title" style="-fx-font-size: 18;" />
                <Label text="Les demandes apparaîtront ici lorsque des patients réserveront."
                       styleClass="text-muted" alignment="CENTER" textAlignment="CENTER" />
                <Button text="Gérer mes créneaux" onAction="#handleGoToDispos" styleClass="btn-primary-pill" />
            </VBox>
        </VBox>
    </HBox>
</VBox>