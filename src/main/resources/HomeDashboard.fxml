<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="25.0" styleClass="content-padding" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label styleClass="header-title" text="Tableau de bord Médical" />
            <Label fx:id="lblWelcome" styleClass="header-subtitle" text="Bienvenue, Dr." />
        </VBox>
        <Label fx:id="lblDate" styleClass="date-badge" text="2026-04-12" />
    </HBox>

    <HBox spacing="20.0">
        <VBox styleClass="white-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="RDV DU JOUR" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="statRdvJour" styleClass="stat-value" text="0" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="stat-icon" text="📅" />
            </HBox>
        </VBox>

        <VBox styleClass="white-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="EN ATTENTE" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="statAttente" styleClass="stat-value" text="0" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="stat-icon" text="⏳" />
            </HBox>
        </VBox>

        <VBox styleClass="white-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="TOTAL PATIENTS" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="statPatients" styleClass="stat-value" text="0" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="stat-icon" text="👥" />
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="25.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="350.0" spacing="20.0" styleClass="white-card">
            <Label styleClass="section-title" text="Prochain Patient" />
            <VBox alignment="CENTER" spacing="10">
                <StackPane>
                    <Circle fx:id="patientCircle" fill="DODGERBLUE" radius="60.0" stroke="WHITE" strokeWidth="3.0" />
                    <ImageView fx:id="imgNextPatient" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
                </StackPane>
                <Label fx:id="lblNextPatientName" styleClass="patient-name" text="Aucun patient" />
                <Label fx:id="lblNextPatientTime" styleClass="time-badge" text="--:--" />
            </VBox>

            <VBox spacing="5" styleClass="motif-box">
                <Label styleClass="motif-label" text="Motif :" />
                <Label fx:id="lblNextPatientMotif" styleClass="motif-text" text="Consul. Générale" wrapText="true" />
            </VBox>
            <Button fx:id="btnStartConsult" maxWidth="Infinity" onAction="#handleStartConsultation" styleClass="btn-primary-green" text="Démarrer la consultation" />
        </VBox>

        <VBox spacing="15.0" styleClass="white-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Aperçu Hebdomadaire" />
            <TableView fx:id="tableRdv" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colPatient" prefWidth="200.0" text="Patient" />
                    <TableColumn fx:id="colDate" prefWidth="150.0" text="Date &amp; Heure" />
                    <TableColumn fx:id="colStatut" prefWidth="100.0" text="Statut" />
                    <TableColumn fx:id="colAction" prefWidth="80.0" text="Action" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>