<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" stylesheets="/css/style.css" styleClass="front-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.ReclamationFrontController">
    <top>
        <fx:include source="/Navbar.fxml" />
    </top>

    <center>
        <VBox style="-fx-padding: 30; -fx-alignment: top-center;">
            <VBox VBox.vgrow="ALWAYS" spacing="25" maxWidth="1200">

                <!-- HEADER ET STATS INTÉRIEURES -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Vos réclamations" styleClass="front-title"/>
                        <Label text="Soumettez et suivez l'état de vos demandes" styleClass="front-subtitle"/>
                    </VBox>
                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="↻ Actualiser" onAction="#actualiser" styleClass="front-btn-secondary"/>
                        <Button text="＋ Déposer une réclamation" onAction="#viderFormulaire" styleClass="front-btn-primary"/>
                    </HBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label fx:id="lblTotalFront" text="0" styleClass="front-stats-badge-attente" style="-fx-text-fill: #3b82f6;"/>
                    <Label text="demande(s) trouvée(s)" styleClass="front-subtitle"/>
                    <Region prefWidth="20" />
                    <Label text="En attente:" styleClass="front-subtitle"/>
                    <Label fx:id="lblFrontAttente" text="0" styleClass="front-stats-badge-attente"/>
                    <Region prefWidth="20"/>
                    <Label text="Traitées:" styleClass="front-subtitle"/>
                    <Label fx:id="lblFrontTraite" text="0" styleClass="front-stats-badge-traitee"/>
                </HBox>

                <!-- CORPS PRINCIPAL: TABLE + FORMULAIRE + CHATBOT -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <!-- ZONE TABLEAU (A gauche) -->
                    <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" styleClass="front-glass-card" style="-fx-padding: 15;">
                        <Label text="Liste de vos demandes" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1e293b; -fx-padding: 0 0 10 0;"/>
                        <TableView fx:id="tableReclamation" onMouseClicked="#handleTableClick" VBox.vgrow="ALWAYS" styleClass="front-table">
                            <columns>
                                <TableColumn fx:id="colTitre" text="Titre de la réclamation" prefWidth="250" />
                                <TableColumn fx:id="colCategorie" text="Type / Catégorie" prefWidth="130" />
                                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120" />
                                <TableColumn fx:id="colDate" text="Date de Soumission" prefWidth="150" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <!-- ZONE FORMULAIRE D'EDITION (A droite) -->
                    <VBox spacing="15" prefWidth="380" minWidth="380" styleClass="front-glass-card" style="-fx-padding: 20;">
                        <Label text="📋 Détails de la réclamation" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #152536;"/>

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <VBox spacing="15" style="-fx-padding: 5 10 5 5;">

                                <VBox spacing="4">
                                    <Label text="Sujet de votre demande *" styleClass="front-form-label"/>
                                    <TextField fx:id="txtTitre" promptText="L'objet de la réclamation" styleClass="front-form-field"/>
                                </VBox>

                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Nom complet *" styleClass="front-form-label"/>
                                        <TextField fx:id="txtPatient" promptText="Prénom &amp; Nom" styleClass="front-form-field"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Email *" styleClass="front-form-label"/>
                                        <TextField fx:id="txtEmail" promptText="email@domaine.com" styleClass="front-form-field"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Catégorie *" styleClass="front-form-label"/>
                                        <ComboBox fx:id="cmbCategorie" promptText="Choisir" maxWidth="Infinity" styleClass="front-form-field" style="-fx-padding: 6 12;"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Priorité *" styleClass="front-form-label"/>
                                        <ComboBox fx:id="cmbPriorite" promptText="Choisir" maxWidth="Infinity" styleClass="front-form-field" style="-fx-padding: 6 12;"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="4">
                                    <Label text="Description détaillée *" styleClass="front-form-label"/>
                                    <TextArea fx:id="txtDescription" promptText="Veuillez détailler le plus possible..." prefRowCount="4" wrapText="true" styleClass="front-form-field"/>
                                </VBox>

                                <VBox spacing="4" style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;">
                                    <Label text="💬 Réponse de l'administration" styleClass="front-form-label" style="-fx-text-fill: #334155;"/>
                                    <TextArea fx:id="txtReponse" editable="false" promptText="En attente de traitement..." styleClass="front-form-field readonly-field" style="-fx-background-color: transparent; -fx-border-width: 0;" prefRowCount="3" wrapText="true"/>
                                </VBox>
                            </VBox>
                        </ScrollPane>

                        <VBox spacing="10">
                            <Button fx:id="btnAjouter" text="💾 Sauvegarder" onAction="#soumettreReclamation" styleClass="front-btn-primary" maxWidth="Infinity"/>
                            <HBox spacing="10">
                                <Button fx:id="btnModifier" text="✏ Modifier" onAction="#modifierReclamation" styleClass="front-btn-action-update" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="🗑 Supprimer" onAction="#supprimerReclamation" styleClass="front-btn-action-delete" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ZONE CHATBOT GROK (A l'extreme droite) -->
                    <VBox spacing="15" prefWidth="300" minWidth="280" styleClass="front-glass-card-ai" style="-fx-padding: 20;">
                        <Label text="🤖 Assistant Grok" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #9333ea;"/>
                        
                        <Label text="Je peux vous aider à rédiger votre réclamation et remplir le formulaire automatiquement." wrapText="true" style="-fx-text-fill: #6b21a8; -fx-font-size: 12px;"/>

                        <TextArea fx:id="txtChatbot" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="front-form-field readonly-field" style="-fx-background-color: rgba(255,255,255,0.7); -fx-border-color: #e9d5ff;"/>

                        <HBox spacing="10">
                            <TextField fx:id="txtChatInput" promptText="Expliquez-moi..." styleClass="front-form-field" HBox.hgrow="ALWAYS" onAction="#sendChatMessage"/>
                            <Button fx:id="btnChatSendMessage" text="➤" onAction="#sendChatMessage" styleClass="front-btn-ai" style="-fx-padding: 8 16;"/>
                        </HBox>

                        <Button fx:id="btnAutoFill" text="✨ Remplissage Rapide" onAction="#autoFillForm" styleClass="front-btn-ai" maxWidth="Infinity"/>
                    </VBox>

                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>


