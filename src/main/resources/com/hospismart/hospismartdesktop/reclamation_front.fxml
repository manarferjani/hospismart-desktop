<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" stylesheets="/css/style.css" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.ReclamationFrontController">
    <top>
        <fx:include source="/Navbar.fxml" />
    </top>

    <center>
        <VBox style="-fx-padding: 30; -fx-alignment: top-center;">
            <VBox styleClass="front-main-container" VBox.vgrow="ALWAYS" spacing="20" maxWidth="1200">

                <!-- HEADER ET STATS INTÉRIEURES -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Vos réclamations" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #152536;"/>
                        <Label text="Soumettez et suivez l'état de vos demandes" style="-fx-font-size: 14px; -fx-text-fill: #6e7a89;"/>
                    </VBox>
                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="↻ Actualiser" onAction="#actualiser" styleClass="btn-filter" style="-fx-background-color: transparent; -fx-border-color: #d1dced; -fx-border-radius: 20; -fx-text-fill: #152536;"/>
                        <Button text="＋ Déposer une réclamation" onAction="#viderFormulaire" styleClass="btn-solid-primary"/>
                    </HBox>
                </HBox>

                <Separator style="-fx-padding: 10 0;"/>

                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                    <Label fx:id="lblTotalFront" text="0" style="-fx-font-weight: 800; -fx-font-size: 16px; -fx-text-fill: #246bfd;"/>
                    <Label text="demande(s) trouvée(s)" style="-fx-text-fill: #6e7a89;"/>
                    <Region prefWidth="30" />
                    <Label text="En attente:" style="-fx-text-fill: #6e7a89;"/>
                    <Label fx:id="lblFrontAttente" text="0" style="-fx-text-fill: #e67e22; -fx-font-weight: 800;"/>
                    <Region prefWidth="30"/>
                    <Label text="Traitées:" style="-fx-text-fill: #6e7a89;"/>
                    <Label fx:id="lblFrontTraite" text="0" style="-fx-text-fill: #2ecc71; -fx-font-weight: 800;"/>
                </HBox>

                <!-- CORPS PRINCIPAL: TABLE + FORMULAIRE -->
                <HBox spacing="25" VBox.vgrow="ALWAYS">

                    <!-- ZONE TABLEAU (A gauche) -->
                    <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #edf2f7; -fx-border-width: 1;">
                        <TableView fx:id="tableReclamation" onMouseClicked="#handleTableClick" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colTitre" text="Titre de la réclamation" prefWidth="250" />
                                <TableColumn fx:id="colCategorie" text="Type / Catégorie" prefWidth="130" />
                                <TableColumn fx:id="colStatut" text="Statut actuel" prefWidth="120" />
                                <TableColumn fx:id="colDate" text="Date de Soumission" prefWidth="160" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <!-- ZONE FORMULAIRE D'EDITION (A droite) -->
                    <VBox spacing="15" prefWidth="420" minWidth="400" style="-fx-background-color: #f8fbff; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #edf2f7; -fx-border-radius: 15; -fx-border-width: 1;">
                        <Label text="📋 Détails de la réclamation" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #152536;"/>

                        <ScrollPane fitToWidth="true" styleClass="form-scrollpane" VBox.vgrow="ALWAYS">
                            <VBox spacing="15">
                                <padding><Insets right="5" top="5" bottom="5"/></padding>

                                <VBox spacing="2">
                                    <Label text="Sujet de votre demande *" styleClass="form-label"/>
                                    <TextField fx:id="txtTitre" promptText="L'objet de la réclamation" styleClass="form-field"/>
                                </VBox>

                                <HBox spacing="10">
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Nom complet *" styleClass="form-label"/>
                                        <TextField fx:id="txtPatient" promptText="Prénom &amp; Nom" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Email *" styleClass="form-label"/>
                                        <TextField fx:id="txtEmail" promptText="email@domaine.com" styleClass="form-field"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="10">
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Catégorie *" styleClass="form-label"/>
                                        <ComboBox fx:id="cmbCategorie" promptText="Choisir" maxWidth="Infinity" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Priorité *" styleClass="form-label"/>
                                        <ComboBox fx:id="cmbPriorite" promptText="Choisir" maxWidth="Infinity" styleClass="form-field"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="2">
                                    <Label text="Description détaillée *" styleClass="form-label"/>
                                    <TextArea fx:id="txtDescription" promptText="Veuillez détailler le plus possible..." prefRowCount="4" wrapText="true" styleClass="form-field"/>
                                </VBox>

                                <VBox spacing="2" styleClass="response-box" style="-fx-padding: 12; -fx-background-color: #f8fbff; -fx-border-color: #d1dced; -fx-border-width: 1;">
                                    <Label text="💬 Reponse de l'administration" styleClass="form-label response-label"/>
                                    <TextArea fx:id="txtReponse" editable="false" promptText="En attente de traitement par le support..." styleClass="form-field readonly-field" prefRowCount="3" wrapText="true"/>
                                </VBox>
                            </VBox>
                        </ScrollPane>

                        <Separator />
                        <HBox spacing="10">
                            <Button fx:id="btnAjouter" text="💾 Sauvegarder" onAction="#soumettreReclamation" styleClass="btn-action-add" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-padding: 10; -fx-font-size: 14px;"/>
                        </HBox>
                        <HBox spacing="10">
                            <Button fx:id="btnModifier" text="✏ Modifier" onAction="#modifierReclamation" styleClass="btn-action-update" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-padding: 9;"/>
                            <Button text="🗑 Supprimer" onAction="#supprimerReclamation" styleClass="btn-action-delete" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-padding: 9;"/>
                        </HBox>
                    </VBox>

                    <!-- ZONE CHATBOT GROK (A l'extreme droite) -->
                    <VBox spacing="15" prefWidth="300" minWidth="280" style="-fx-background-color: #f0f7ff; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #d1e2f3; -fx-border-radius: 15; -fx-border-width: 1;">
                        <Label text="🤖 Assistant Grok" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #246bfd;"/>

                        <TextArea fx:id="txtChatbot" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="form-field readonly-field" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" text="Bonjour ! Je suis l'assistant IA Grok.&#10;Décrivez-moi votre problème en quelques mots et je remplirai le formulaire automatiquement pour vous !&#10;"/>

                        <HBox spacing="10">
                            <TextField fx:id="txtChatInput" promptText="Décrivez le souci..." styleClass="form-field" HBox.hgrow="ALWAYS" onAction="#sendChatMessage"/>
                            <Button fx:id="btnChatSendMessage" text="➤" onAction="#sendChatMessage" styleClass="btn-solid-primary" style="-fx-padding: 6 12;"/>
                        </HBox>

                        <Button fx:id="btnAutoFill" text="✨ Remplissage Rapide" onAction="#autoFillForm" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" maxWidth="Infinity"/>
                    </VBox>

                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>


