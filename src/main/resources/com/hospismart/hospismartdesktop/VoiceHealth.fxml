<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="750.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f9;" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.VoiceHealthController">
   <children>
      <!-- Header -->
      <AnchorPane prefHeight="70.0" prefWidth="1000.0" style="-fx-background-color: #1a2a3a;">
         <children>
            <Label layoutX="30.0" layoutY="20.0" text="🎤 Consultation Vocale - Bilan de Santé" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Button layoutX="850.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="30.0" prefWidth="130.0" styleClass="btn-secondary" text="⬅️ Retour" />
         </children>
      </AnchorPane>

      <!-- Content Area -->
      <VBox layoutX="30.0" layoutY="100.0" prefHeight="620.0" prefWidth="940.0" spacing="20.0">
         
         <!-- Instructions -->
         <AnchorPane prefHeight="80.0" styleClass="card-pane">
            <children>
               <Label layoutX="20.0" layoutY="10.0" text="Instructions:" textFill="#1565C0">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
               <Label layoutX="20.0" layoutY="35.0" prefHeight="40.0" prefWidth="900.0" text="Cliquez sur le bouton 'Démarrer Enregistrement' et décrivez vos symptômes pendant 10 secondes. L'IA génèrera automatiquement un bilan de santé professionnel." wrapText="true" />
            </children>
         </AnchorPane>

         <!-- Recording Controls -->
         <AnchorPane prefHeight="100.0" styleClass="card-pane">
            <children>
               <Label layoutX="20.0" layoutY="15.0" text="Enregistrement Vocal:" textFill="#1565C0">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
               
               <HBox layoutX="20.0" layoutY="45.0" spacing="10.0">
                  <Button fx:id="startButton" mnemonicParsing="false" onAction="#handleStartRecording" prefHeight="40.0" prefWidth="180.0" styleClass="btn-primary" text="🎤 Démarrer Enregistrement" />
                  <Button fx:id="stopButton" disable="true" mnemonicParsing="false" onAction="#handleStopRecording" prefHeight="40.0" prefWidth="180.0" styleClass="btn-danger" text="⏹️ Arrêter" />
                  <Label fx:id="statusLabel" prefHeight="40.0" prefWidth="500.0" style="-fx-font-size: 14; -fx-text-fill: #666666;" text="Prêt à enregistrer" />
               </HBox>
            </children>
         </AnchorPane>

         <!-- Transcription -->
         <AnchorPane prefHeight="120.0" styleClass="card-pane">
            <children>
               <Label layoutX="20.0" layoutY="10.0" text="Texte Reconnu:" textFill="#1565C0">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
               <TextArea fx:id="transcriptionArea" layoutX="20.0" layoutY="35.0" prefHeight="75.0" prefWidth="900.0" style="-fx-font-size: 12; -fx-control-inner-background: #ffffff;" wrapText="true" />
            </children>
         </AnchorPane>

         <!-- AI Health Summary -->
         <AnchorPane prefHeight="280.0" styleClass="card-pane">
            <children>
               <Label layoutX="20.0" layoutY="10.0" text="🤖 Bilan de Santé (Généré par IA):" textFill="#1565C0">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
               <TextArea fx:id="summaryArea" layoutX="20.0" layoutY="35.0" prefHeight="240.0" prefWidth="900.0" style="-fx-font-size: 11; -fx-control-inner-background: #f9f9f9; -fx-text-fill: #333333;" wrapText="true" />
               <Button layoutX="800.0" layoutY="280.0" mnemonicParsing="false" onAction="#handleSaveSummary" prefHeight="30.0" prefWidth="120.0" styleClass="btn-success" text="💾 Sauvegarder" />
            </children>
         </AnchorPane>

      </VBox>
   </children>
</AnchorPane>
