<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20" styleClass="back-main" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.BackOfficeUsersController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <VBox spacing="5">
        <Label text="Gestion des Utilisateurs" styleClass="back-page-title" />
        <Label text="Recherchez, filtrez et gérez les comptes de l'application." styleClass="back-page-subtitle" />
    </VBox>

    <!-- Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="action-bar">
        <TextField fx:id="searchField" prefHeight="35.0" prefWidth="250.0" promptText="Rechercher par nom, email..." styleClass="text-input" />
        
        <ComboBox fx:id="filterComboBox" prefHeight="35.0" prefWidth="150.0" promptText="Tous">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="TOUS" />
                    <String fx:value="ADMIN" />
                    <String fx:value="PATIENT" />
                    <String fx:value="MEDECIN" />
                </FXCollections>
            </items>
        </ComboBox>
        
        <Button prefHeight="35.0" mnemonicParsing="false" onAction="#handleSearch" styleClass="btn-secondary" text="Filtrer" />
        <Button prefHeight="35.0" mnemonicParsing="false" onAction="#handleExportPDF" styleClass="btn-tertiary" text="Export PDF" />
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Button prefHeight="35.0" mnemonicParsing="false" onAction="#handleOpenAddDialog" styleClass="btn-primary" text="+ Ajouter un Utilisateur" />
    </HBox>

    <!-- Table View -->
    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNom" prefWidth="200.0" text="Nom Complet" />
            <TableColumn fx:id="colEmail" prefWidth="250.0" text="Email" />
            <TableColumn fx:id="colType" prefWidth="100.0" text="Type" />
            <TableColumn fx:id="colStatut" prefWidth="100.0" text="Statut" />
            <TableColumn fx:id="colActions" prefWidth="200.0" text="Actions" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
