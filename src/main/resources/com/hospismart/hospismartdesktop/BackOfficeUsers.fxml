<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>

<VBox spacing="0" styleClass="back-page-root" stylesheets="/css/style.css"
      xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospismart.hospismartdesktop.controllers.BackOfficeUsersController">

    <!-- ── TOP BAR ──────────────────────────────────────────────── -->
    <HBox styleClass="back-topbar" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="👥  Gestion des Utilisateurs" styleClass="back-topbar-title"/>
            <Label text="Recherchez, filtrez et gérez les comptes de l'application." styleClass="back-topbar-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button mnemonicParsing="false" onAction="#handleOpenAddDialog"
                styleClass="back-btn-add" text="➕  Ajouter un Utilisateur"/>
    </HBox>

    <!-- ── BODY ─────────────────────────────────────────────────── -->
    <VBox spacing="16" VBox.vgrow="ALWAYS" styleClass="back-page-body">
        <padding><Insets top="20" right="22" bottom="16" left="22"/></padding>

        <!-- Toolbar -->
        <HBox styleClass="back-toolbar" alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchField" prefWidth="260" promptText="🔍  Nom, email..." styleClass="back-search-field"/>
            <ComboBox fx:id="filterComboBox" prefWidth="160" promptText="Tous les rôles" styleClass="back-combo">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="TOUS"/>
                        <String fx:value="ADMIN"/>
                        <String fx:value="PATIENT"/>
                        <String fx:value="MEDECIN"/>
                    </FXCollections>
                </items>
            </ComboBox>
            <Button mnemonicParsing="false" onAction="#handleSearch" styleClass="back-btn-secondary" text="Filtrer"/>
            <Button mnemonicParsing="false" onAction="#handleExportPDF" styleClass="back-btn-export" text="📄  Export PDF"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Table -->
        <VBox styleClass="back-table-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colId"      prefWidth="55"  text="ID"/>
                    <TableColumn fx:id="colNom"     prefWidth="200" text="Nom Complet"/>
                    <TableColumn fx:id="colEmail"   prefWidth="260" text="Email"/>
                    <TableColumn fx:id="colType"    prefWidth="120" text="Rôle"/>
                    <TableColumn fx:id="colStatut"  prefWidth="100" text="Statut"/>
                    <TableColumn fx:id="colActions" prefWidth="200" text="Actions"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>
