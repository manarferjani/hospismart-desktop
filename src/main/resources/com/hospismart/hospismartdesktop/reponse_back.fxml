<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" styleClass="back-page-root" stylesheets="/css/style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospismart.hospismartdesktop.controllers.ReponseBackController">

    <!-- ── TOP BAR ──────────────────────────────────────────────── -->
    <HBox styleClass="back-topbar" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="💬  Historique des Réponses" styleClass="back-topbar-title"/>
            <Label text="Consultez, modifiez ou supprimez les réponses envoyées aux patients." styleClass="back-topbar-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⬅ Retour aux réclamations" onAction="#goToReclamations" styleClass="back-btn-secondary" style="-fx-text-fill: #1e40af; -fx-font-weight: bold;"/>
    </HBox>

    <!-- ── BODY ─────────────────────────────────────────────────── -->
    <VBox spacing="16" VBox.vgrow="ALWAYS" styleClass="back-page-body">
        <padding><Insets top="20" right="22" bottom="16" left="22"/></padding>

        <!-- Stats Row -->
        <HBox spacing="14">
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="💬" style="-fx-font-size:22px;"/>
                <Label text="TOTAL" styleClass="back-stats-label"/>
                <Label fx:id="lblTotalReponses" text="0" styleClass="back-stats-value"/>
                <Label text="Réponses envoyées" styleClass="back-stats-sub"/>
            </VBox>
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="👥" style="-fx-font-size:22px;"/>
                <Label text="ADMINS" styleClass="back-stats-label"/>
                <Label fx:id="lblAdminsActifs" text="0" styleClass="back-stats-value back-stats-value-green"/>
                <Label text="Admins actifs" styleClass="back-stats-sub"/>
            </VBox>
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="✅" style="-fx-font-size:22px;"/>
                <Label text="TRAITÉES" styleClass="back-stats-label"/>
                <Label fx:id="lblReclamationsRepondues" text="0" styleClass="back-stats-value back-stats-value-amber"/>
                <Label text="Réclamations répondues" styleClass="back-stats-sub"/>
            </VBox>
        </HBox>

        <!-- Toolbar -->
        <HBox styleClass="back-toolbar" alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="txtRecherche" promptText="🔍  Chercher une réponse ou un admin..."
                       prefWidth="280" styleClass="back-search-field"/>
            <Button text="↻ Rafraîchir" onAction="#actualiser" styleClass="back-btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="💾 Modifier" onAction="#modifierReponse" styleClass="back-btn-add"/>
            <Button text="🗑 Supprimer" onAction="#supprimerReponse" styleClass="back-btn-delete"/>
        </HBox>

        <!-- Content: Chart + Table + Edit panel -->
        <HBox spacing="16" VBox.vgrow="ALWAYS">
            
            <!-- Left: Chart -->
            <VBox styleClass="back-table-card" prefWidth="300" minWidth="280">
                <PieChart fx:id="chartReponses" title="Répartition par admin"
                          legendVisible="true" labelsVisible="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Right: Table & Editor -->
            <VBox spacing="16" HBox.hgrow="ALWAYS">
                <!-- Table -->
                <VBox styleClass="back-table-card" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tableReponse" onMouseClicked="#handleTableClick"
                               VBox.vgrow="ALWAYS" minHeight="200" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="colContenu" text="Contenu de la Réponse" prefWidth="320" />
                            <TableColumn fx:id="colAdminNom" text="Admin" prefWidth="150" />
                            <TableColumn fx:id="colAdminEmail" text="Email Admin" prefWidth="200" />
                            <TableColumn fx:id="colDate" text="Date de Réponse" prefWidth="160" />
                        </columns>
                    </TableView>
                </VBox>

                <!-- Edit Form -->
                <VBox styleClass="back-side-panel" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="✏️ Éditer la réponse sélectionnée" styleClass="back-panel-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <Separator/>

                    <VBox spacing="8">
                        <Label text="Contenu de la réponse" styleClass="form-label"/>
                        <TextArea fx:id="txtReponse" wrapText="true" prefRowCount="3" styleClass="form-field"/>
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Nom Admin" styleClass="form-label"/>
                            <TextField fx:id="txtAdminNom" styleClass="form-field"/>
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Email Admin" styleClass="form-label"/>
                            <TextField fx:id="txtAdminEmail" styleClass="form-field"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</VBox>
