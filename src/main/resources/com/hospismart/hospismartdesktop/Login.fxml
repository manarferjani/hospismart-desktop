<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="768.0" prefWidth="1200.0" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.LoginController">

    <!-- Left side: Background Image -->
    <StackPane HBox.hgrow="ALWAYS" style="-fx-background-image: url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?q=80&amp;w=1000&amp;auto=format&amp;fit=crop'); -fx-background-size: cover; -fx-background-position: center;">
        <VBox alignment="CENTER" style="-fx-background-color: rgba(30, 58, 138, 0.75);">
            <Label text="Bienvenue sur Hospismart" textFill="WHITE" style="-fx-font-size: 42px; -fx-font-weight: bold;"/>
            <Label text="Votre santé, notre priorité." textFill="WHITE" style="-fx-font-size: 20px; -fx-padding: 10 0 0 0;"/>
        </VBox>
    </StackPane>

    <!-- Right side: Login Form -->
    <VBox alignment="CENTER" prefWidth="480.0" spacing="20" style="-fx-background-color: white; -fx-padding: 50;">
        <Label text="H" style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 10 22; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"/>
        <Label text="HospiSmart" textFill="#1e3a8a" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="Connectez-vous à votre espace sécurisé" textFill="#64748b" style="-fx-font-size: 14px; -fx-padding: 0 0 20 0;"/>

        <VBox spacing="8">
            <Label text="Adresse e-mail" style="-fx-text-fill: #475569; -fx-font-weight: bold;"/>
            <TextField fx:id="emailField" prefHeight="45.0" promptText="votre.email@exemple.com" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 15; -fx-font-size: 14px;" />
        </VBox>

        <VBox spacing="8">
            <Label text="Mot de passe" style="-fx-text-fill: #475569; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="••••••••" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 15; -fx-font-size: 14px;" />
        </VBox>

        <Region prefHeight="10" />

        <Button mnemonicParsing="false" onAction="#handleLogin" prefHeight="48.0" maxWidth="Infinity" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Se connecter" />

        <Label text="ou" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>

        <Button mnemonicParsing="false" onAction="#handleFaceLogin" prefHeight="48.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #2563eb; -fx-border-radius: 8; -fx-border-width: 2; -fx-text-fill: #2563eb; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="📷 Connexion par Visage" />

        <Region prefHeight="15" />

        <HBox alignment="CENTER" spacing="30">
            <Hyperlink onAction="#handleForgotPassword" text="Mot de passe oublié ?" style="-fx-text-fill: #64748b; -fx-underline: false; -fx-focus-color: transparent;"/>
            <Hyperlink onAction="#handleGoRegister" text="Créer un compte" style="-fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-underline: false; -fx-focus-color: transparent;"/>
        </HBox>
    </VBox>

</HBox>
