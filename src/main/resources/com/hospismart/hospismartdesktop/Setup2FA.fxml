<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #f4f6f9;" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.SetupTwoFactorController">
   <children>
      <!-- Titre -->
      <Label layoutX="50.0" layoutY="20.0" text="Configuration de l'Authentification à Deux Facteurs (2FA)" textFill="#1565C0">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <!-- Description -->
      <Label layoutX="50.0" layoutY="60.0" prefHeight="60.0" prefWidth="800.0" text="La 2FA ajoute une couche de sécurité à votre compte. Vous devrez entrer un code généré par Google Authenticator lors de chaque connexion." textFill="#666666" wrapText="true">
         <font>
            <Font size="12.0" />
         </font>
      </Label>

      <!-- Étape 1: Télécharger l'application -->
      <BorderPane layoutX="50.0" layoutY="130.0" prefHeight="120.0" prefWidth="800.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #ffffff;">
         <left>
            <Label text="📱 Étape 1" style="-fx-font-size: 18; -fx-padding: 20;" />
         </left>
         <center>
            <VBox spacing="5.0" style="-fx-padding: 20;">
               <Label text="Téléchargez Google Authenticator" style="-fx-font-size: 14; -fx-font-weight: bold;" />
               <Label text="Disponible sur iOS et Android" style="-fx-font-size: 11; -fx-text-fill: #666666;" />
            </VBox>
         </center>
      </BorderPane>

      <!-- Étape 2: Scanner le QR Code -->
      <BorderPane layoutX="50.0" layoutY="260.0" prefHeight="350.0" prefWidth="800.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #ffffff;">
         <top>
            <HBox spacing="10.0" style="-fx-padding: 20;">
               <Label text="🔐 Étape 2" style="-fx-font-size: 18;" />
               <Label text="Scannez ce QR Code" style="-fx-font-size: 14; -fx-font-weight: bold;" />
            </HBox>
         </top>
         <center>
            <VBox alignment="CENTER" spacing="15.0">
               <ImageView fx:id="qrCodeImageView" fitHeight="200.0" fitWidth="200.0" preserveRatio="true" />
               <Label text="Ou entrez manuellement cette clé:" style="-fx-font-size: 12; -fx-text-fill: #666666;" />
               <Label fx:id="secretKeyLabel" style="-fx-font-size: 11; -fx-font-family: 'Courier New'; -fx-text-fill: #1565C0; -fx-border-color: #e0e0e0; -fx-padding: 10;" text="[Clé secrète affichée ici]" />
               <Button mnemonicParsing="false" onAction="#handleCopySecret" prefHeight="30.0" prefWidth="150.0" text="📋 Copier la clé" />
            </VBox>
         </center>
      </BorderPane>

      <!-- Étape 3: Vérifier le code -->
      <BorderPane layoutX="50.0" layoutY="620.0" prefHeight="50.0" prefWidth="800.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #ffffff;">
         <left>
            <Label text="✅ Étape 3" style="-fx-font-size: 18; -fx-padding: 15;" />
         </left>
         <center>
            <HBox spacing="10.0" style="-fx-padding: 15;">
               <TextField fx:id="verificationCodeField" prefHeight="30.0" prefWidth="150.0" promptText="Code 6 chiffres" />
               <Button mnemonicParsing="false" onAction="#handleVerifyCode" prefHeight="30.0" prefWidth="120.0" text="Vérifier" />
            </HBox>
         </center>
      </BorderPane>

      <!-- Boutons d'action -->
      <HBox layoutX="200.0" layoutY="660.0" spacing="15.0">
         <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="130.0" style="-fx-font-size: 12; -fx-background-color: #757575; -fx-text-fill: white;" text="⬅️ Retour" />
         <Button fx:id="skipButton" mnemonicParsing="false" onAction="#handleSkip" prefHeight="40.0" prefWidth="130.0" style="-fx-font-size: 12; -fx-background-color: #FF9800; -fx-text-fill: white;" text="⏭️ Passer" />
         <Button fx:id="enableButton" mnemonicParsing="false" onAction="#handleEnable" prefHeight="40.0" prefWidth="150.0" style="-fx-font-size: 12;" text="✅ Activer 2FA" />
      </HBox>
   </children>
</AnchorPane>
