<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="768.0" prefWidth="1024.0" stylesheets="/css/style.css" style="-fx-background-color: #f8fafc; -fx-padding: 40; -fx-alignment: top-center;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.MedicamentFrontController">
    <VBox VBox.vgrow="ALWAYS" spacing="30" maxWidth="1000">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="10">
            <HBox alignment="CENTER" spacing="10">
                <StackPane style="-fx-background-color: #0d6efd; -fx-background-radius: 8; -fx-padding: 8;">
                    <Label text="💊" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20;"/>
                </StackPane>
                <Label text="Stocks Pharmaceutiques" style="-fx-font-size: 36px; -fx-text-fill: #1a56db; -fx-font-weight: 800;"/>
            </HBox>
            <Label text="Consultez la disponibilité de nos médicaments en temps réel." style="-fx-font-size: 16px; -fx-text-fill: #64748b;"/>
        </VBox>

        <!-- SEARCH BAR -->
        <HBox alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-background-radius: 50; -fx-padding: 10 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" prefWidth="800">
                <Label text="🔍" style="-fx-text-fill: #94a3b8; -fx-font-size: 16;"/>
                <TextField fx:id="txtSearch" promptText="Rechercher un médicament..." style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8;" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cmbCategorie" promptText="Toutes les catégories" style="-fx-background-color: #f1f5f9; -fx-background-radius: 20; -fx-padding: 5 15; -fx-font-size: 13px; -fx-cursor: hand;" />
                <Label fx:id="lblTotal" text="22 résultats" style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20;"/>
            </HBox>
        </HBox>

        <!-- GRILLE DES MEDICAMENTS -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;" styleClass="edge-to-edge">
            <FlowPane fx:id="flowPaneMedicaments" hgap="25" vgap="25" alignment="CENTER" style="-fx-padding: 20;" />
        </ScrollPane>

    </VBox>
</VBox>
