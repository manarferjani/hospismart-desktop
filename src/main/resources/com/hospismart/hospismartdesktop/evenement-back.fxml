<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospismart.hospismartdesktop.controllers.EvenementBackController"
      spacing="0">

    <!-- ══════════════════════════════════════════════════════════
         LEFT SIDEBAR
         ══════════════════════════════════════════════════════════ -->
    <VBox styleClass="back-sidebar">

        <!-- Logo -->
        <HBox styleClass="sidebar-logo-area">
            <Label text="HospiSmart" styleClass="sidebar-logo-text"/>
            <Region prefWidth="8"/>
            <Label text="ADMIN" styleClass="sidebar-badge"/>
        </HBox>

        <!-- Avatar Area -->
        <VBox styleClass="sidebar-avatar-area">
            <StackPane styleClass="sidebar-avatar">
                <Label text="A" styleClass="sidebar-avatar-letter"/>
            </StackPane>
            <Label text="Administrateur" styleClass="sidebar-user-name"/>
            <Label text="GESTIONNAIRE" styleClass="sidebar-user-role"/>
        </VBox>

        <!-- Overview Section -->
        <Label text="OVERVIEW" styleClass="sidebar-section-header"/>

        <!-- Dashboard / Evenements (active) -->
        <HBox styleClass="sidebar-nav-item-active">
            <padding><Insets left="14" right="14"/></padding>
            <Label text="Evenements" styleClass="sidebar-nav-text-active"/>
        </HBox>

        <!-- Stats -->
        <HBox styleClass="sidebar-nav-item" onMouseClicked="#onGoStats">
            <padding><Insets left="14" right="14"/></padding>
            <Label text="📊 Statistiques" styleClass="sidebar-nav-text"/>
        </HBox>

        <!-- Gestion Section -->
        <Label text="GESTION" styleClass="sidebar-section-header"/>

        <HBox styleClass="sidebar-nav-item" onMouseClicked="#onGoFront">
            <Label text="Vue Publique" styleClass="sidebar-nav-text"/>
        </HBox>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Bottom -->
        <Label text="Deconnexion" styleClass="sidebar-bottom-link" onMouseClicked="#onRetour"/>
        <Label text="PIDEV 2025-2026" styleClass="sidebar-footer"/>

    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         MAIN CONTENT
         ══════════════════════════════════════════════════════════ -->
    <VBox styleClass="back-main" HBox.hgrow="ALWAYS">

        <!-- Title Row -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Gestion des Evenements" styleClass="back-page-title"/>
                <Label fx:id="countLabel" text="0 evenement(s) enregistres." styleClass="back-page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="📊 Stats" onAction="#onGoStats" styleClass="btn-outlined"/>
            <Button text="+ Ajouter" onAction="#onAdd" styleClass="btn-add-green"/>
        </HBox>

        <!-- Toolbar -->
        <HBox styleClass="back-toolbar">
            <ComboBox fx:id="typeFilter"   styleClass="combo-filter" promptText="Type"/>
            <ComboBox fx:id="statutFilter" styleClass="combo-filter" promptText="Statut"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField"
                       promptText="Rechercher..."
                       styleClass="back-search-field"
                       onAction="#onSearch"/>
            <Button text="Actualiser" onAction="#onReset" styleClass="btn-outlined"/>
        </HBox>

        <!-- Data Table -->
        <TableView fx:id="evenementTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitre"     text="Titre"        prefWidth="180" minWidth="120"/>
                <TableColumn fx:id="colType"      text="Type"         prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colDateDebut"  text="Date Debut"  prefWidth="140" minWidth="110"/>
                <TableColumn fx:id="colDateFin"   text="Date Fin"     prefWidth="140" minWidth="110"/>
                <TableColumn fx:id="colLieu"      text="Lieu"         prefWidth="130" minWidth="100"/>
                <TableColumn fx:id="colStatut"    text="Statut"       prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colBudget"    text="Budget"       prefWidth="90"  minWidth="70"/>
                <TableColumn fx:id="colActions"   text="Actions"      prefWidth="240" minWidth="200" sortable="false" resizable="false"/>
            </columns>
            <placeholder>
                <Label text="Aucun evenement trouve. Cliquez sur + Ajouter pour creer le premier."
                       style="-fx-text-fill:#94A3B8; -fx-font-size:14px;"/>
            </placeholder>
        </TableView>

        <!-- Pagination Bar -->
        <HBox fx:id="paginationBox" spacing="12" alignment="CENTER"
              style="-fx-padding: 10 0 4 0;">
            <Button fx:id="btnPrevPage" text="← Précédent" onAction="#onPrevPage" styleClass="btn-outlined"/>
            <Label fx:id="pageInfoLabel" text="Page 1 / 1" style="-fx-text-fill:#64748b; -fx-font-size:13px; -fx-font-weight:600;"/>
            <Button fx:id="btnNextPage" text="Suivant →" onAction="#onNextPage" styleClass="btn-outlined"/>
        </HBox>

        <!-- Footer -->
        <Label fx:id="footerLabel" text="0 evenements charges." styleClass="back-footer-label"/>

    </VBox>

</HBox>
