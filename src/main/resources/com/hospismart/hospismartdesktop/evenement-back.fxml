<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospismart.hospismartdesktop.controllers.EvenementBackController"
      spacing="0">

    <!-- ── Header bar ────────────────────────────────────────────── -->
    <HBox styleClass="app-header" spacing="10">
        <Button text="←  Retour" onAction="#onRetour" styleClass="btn-retour"/>
        <Label text="🏥  HospiSmart" styleClass="app-title"/>
        <Label text="— Administration" styleClass="app-subtitle" style="-fx-padding: 2 0 0 6;"/>
    </HBox>

    <!-- ── Toolbar ──────────────────────────────────────────────── -->
    <HBox styleClass="toolbar-area" spacing="10">

        <TextField fx:id="searchField"
                   promptText="🔍  Rechercher par titre, lieu..."
                   styleClass="search-field"
                   onAction="#onSearch"/>

        <ComboBox fx:id="typeFilter"   styleClass="combo-filter" promptText="Type"/>
        <ComboBox fx:id="statutFilter" styleClass="combo-filter" promptText="Statut"/>

        <Button text="Filtrer"         onAction="#onSearch" styleClass="btn-secondary"/>
        <Button text="↺  Réinitialiser" onAction="#onReset"  styleClass="btn-secondary"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="countLabel" text="0 événement(s)" styleClass="count-label"
               style="-fx-padding: 0 8 0 0;"/>

        <Button text="➕  Ajouter un Événement" onAction="#onAdd" styleClass="btn-primary"/>
    </HBox>

    <!-- ── Data Table ───────────────────────────────────────────── -->
    <TableView fx:id="evenementTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"       text="ID"           prefWidth="55"  minWidth="40"  sortable="true"/>
            <TableColumn fx:id="colTitre"    text="Titre"        prefWidth="195" minWidth="120"/>
            <TableColumn fx:id="colType"     text="Type"         prefWidth="110" minWidth="80"/>
            <TableColumn fx:id="colDateDebut" text="Date Début"  prefWidth="148" minWidth="110" sortable="false"/>
            <TableColumn fx:id="colDateFin"  text="Date Fin"     prefWidth="148" minWidth="110" sortable="false"/>
            <TableColumn fx:id="colLieu"     text="Lieu"         prefWidth="140" minWidth="100"/>
            <TableColumn fx:id="colStatut"   text="Statut"       prefWidth="100" minWidth="80"/>
            <TableColumn fx:id="colBudget"   text="Budget"       prefWidth="112" minWidth="80"  sortable="false"/>
            <TableColumn fx:id="colActions"  text="Actions"      prefWidth="260" minWidth="240" sortable="false" resizable="false"/>
        </columns>
        <placeholder>
            <Label text="Aucun événement trouvé. Cliquez sur « Ajouter » pour créer le premier."
                   style="-fx-text-fill:#94A3B8; -fx-font-size:14px;"/>
        </placeholder>
    </TableView>

</VBox>
