<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hospismart.hospismartdesktop.controllers.MainController"
            stylesheets="@hospismart.css">

    <!-- ===================== SIDEBAR ===================== -->
    <left>
        <VBox styleClass="sidebar" spacing="2">

            <!-- Brand / Logo -->
            <VBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="2">
                <Label text="❤️  Hospismart" styleClass="sidebar-brand-label"/>
                <Label text="OASIS — Gestion des Stocks" styleClass="sidebar-brand-sub"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" spacing="2" style="-fx-padding: 12 8 8 8;">

                <!-- Section: Navigation -->
                <Label text="NAVIGATION" styleClass="menu-header"/>
                <Button fx:id="btnMedicaments" text="💊  Médicaments"
                        onAction="#showMedicaments"
                        styleClass="nav-button" maxWidth="Infinity"/>

                <!-- Section: Gestion -->
                <Label text="GESTION" styleClass="menu-header"/>
                <Button fx:id="btnCategories" text="🏷️  Catégories"
                        onAction="#showCategories"
                        styleClass="nav-button" maxWidth="Infinity"/>
                <Button fx:id="btnMouvements" text="📦  Mouvements Stock"
                        onAction="#showMouvements"
                        styleClass="nav-button" maxWidth="Infinity"/>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS"/>

                <!-- Footer (équivalent "Voir le site" du back.html.twig) -->
                <VBox styleClass="sidebar-footer" spacing="4">
                    <Button text="🌐  Catalogue Public"
                            onAction="#handleGoFront"
                            styleClass="nav-button" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: #38bdf8;
                                   -fx-font-size: 13px; -fx-padding: 10 18; -fx-cursor: hand;
                                   -fx-alignment: CENTER_LEFT;"/>
                    <Label text="PIDEV 2025-2026"
                           style="-fx-text-fill: #475569; -fx-font-size: 10px; -fx-padding: 0 0 0 10;"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- ===================== CONTENU ===================== -->
    <center>
        <StackPane fx:id="contentArea" styleClass="main-content"/>
    </center>
</BorderPane>
