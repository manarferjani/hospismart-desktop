<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hospismart.hospismartdesktop.controllers.MainController"
            stylesheets="/css/style.css">

    <!-- ===================== SIDEBAR ===================== -->
    <left>
        <VBox styleClass="sidebar-pro" spacing="0">

            <!-- Brand / Logo -->
            <VBox styleClass="sidebar-pro-brand" alignment="CENTER_LEFT" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🏥" style="-fx-font-size:26px;"/>
                    <VBox spacing="1">
                        <Label text="HospiSmart" styleClass="sidebar-pro-brand-label"/>
                        <Label text="BACK OFFICE  •  ADMIN" styleClass="sidebar-pro-brand-sub"/>
                    </VBox>
                </HBox>
            </VBox>

            

            <!-- Nav Sections -->
            <VBox VBox.vgrow="ALWAYS" spacing="2" style="-fx-padding: 18 10 10 10;">

                <!-- Section: Pharmacie & Stocks -->
                <Label text="PHARMACIE &amp; STOCKS" styleClass="sidebar-pro-section-label"/>

                <Button fx:id="btnDashboard" text="📊   Tableau de Bord"
                        onAction="#showDashboard"
                        styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"/>
                <Button fx:id="btnMedicaments" text="💊   Médicaments"
                        onAction="#showMedicaments"
                        styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"/>
                <Button fx:id="btnCategories" text="🏷️   Catégories"
                        onAction="#showCategories"
                        styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"/>
                <Button fx:id="btnMouvements" text="📦   Mouvements Stock"
                        onAction="#showMouvements"
                        styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"/>

                <!-- Section: Administration -->
                <Label text="ADMINISTRATION" styleClass="sidebar-pro-section-label" style="-fx-padding: 20 0 5 15;"/>
                <Button fx:id="btnUsers" text="👥   Utilisateurs"
                        onAction="#showUsers"
                        styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"/>
                <Button fx:id="btnReclamations" text="📋   Réclamations"
                        onAction="#showReclamations"
                        styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"/>
                <Button fx:id="btnEvenements" text="📅   Événements"
                        onAction="#showEvenements"
                        styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"/>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS"/>

                <!-- Status Card -->
                <VBox styleClass="sidebar-pro-status-card" spacing="5" alignment="CENTER_LEFT">
                    <Label text="🟢  Système opérationnel" style="-fx-text-fill:#34d399;-fx-font-size:11px;-fx-font-weight:700;"/>
                    <Label text="Base de données connectée" style="-fx-text-fill:rgba(255,255,255,0.45);-fx-font-size:10px;"/>
                </VBox>

                <!-- Footer actions -->
                <VBox styleClass="sidebar-pro-footer" spacing="4">
                    <Button text="🌐   Catalogue Public"
                            onAction="#handleGoFront"
                            styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"
                            style="-fx-text-fill: #38bdf8;"/>
                    <Button text="🚪   Déconnexion"
                            onAction="#handleLogout"
                            styleClass="sidebar-pro-nav-btn" maxWidth="Infinity"
                            style="-fx-text-fill: #f87171;"/>
                    <Label text="PIDEV 2025 – 2026"
                           style="-fx-text-fill: rgba(255,255,255,0.2); -fx-font-size: 9px; -fx-padding: 4 0 0 12;"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- ===================== CONTENU ===================== -->
    <center>
        <StackPane fx:id="contentArea" styleClass="main-content-pro"/>
    </center>
</BorderPane>
