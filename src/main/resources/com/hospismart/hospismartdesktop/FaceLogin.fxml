<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f4f6f9;" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.FaceLoginController">
    <children>
        <!-- Top Navbar -->
        <AnchorPane prefHeight="60.0" styleClass="top-navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
           <children>
              <Label layoutX="30.0" layoutY="18.0" styleClass="navbar-title" text="HospiSmart — Reconnaissance Faciale" textFill="WHITE">
                 <font>
                    <Font name="System Bold" size="16.0" />
                 </font>
              </Label>
           </children>
        </AnchorPane>

        <!-- Main Content Centered -->
        <VBox alignment="CENTER" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="Connexion par Reconnaissance Faciale" textFill="#1565c0">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                        <Label text="Veuillez positionner votre visage dans le cadre pour vous connecter de manière sécurisée" textFill="#666666">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Cadre pour le flux vidéo -->
                <BorderPane maxWidth="800.0" prefHeight="450.0" prefWidth="800.0" style="-fx-border-color: #1565C0; -fx-border-width: 4; -fx-border-radius: 12; -fx-background-radius: 12; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);">
                    <center>
                        <ImageView fx:id="cameraView" fitHeight="450.0" fitWidth="800.0" preserveRatio="true" />
                    </center>
                </BorderPane>

                <VBox alignment="CENTER" spacing="20.0">
                    <children>
                        <!-- Statut -->
                        <Label fx:id="statusLabel" alignment="CENTER" contentDisplay="CENTER" text="✅ Caméra initialisée - Positionnez votre visage" textAlignment="CENTER" textFill="#424242" wrapText="true">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>

                        <!-- Boutons -->
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Button fx:id="captureButton" mnemonicParsing="false" onAction="#handleCapture" prefHeight="50.0" prefWidth="300.0" styleClass="btn-primary" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;" text="📷 Capturer et Connexion" />
                                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" prefHeight="50.0" prefWidth="180.0" styleClass="btn-tertiary" style="-fx-font-size: 16px; -fx-background-radius: 8;" text="❌ Retour" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
