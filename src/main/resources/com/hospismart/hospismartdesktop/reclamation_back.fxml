<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" styleClass="back-page-root" stylesheets="/css/style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospismart.hospismartdesktop.controllers.ReclamationBackController">

    <!-- ── TOP BAR ──────────────────────────────────────────────── -->
    <HBox styleClass="back-topbar" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="📋  Gestion des Réclamations" styleClass="back-topbar-title"/>
            <Label text="Consultez et répondez aux réclamations des patients." styleClass="back-topbar-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="notifIcon" text="🔔" styleClass="back-notif-badge" onMouseClicked="#handleNotifClick"/>
    </HBox>

    <!-- ── BODY ─────────────────────────────────────────────────── -->
    <VBox spacing="16" VBox.vgrow="ALWAYS" styleClass="back-page-body">
        <padding><Insets top="20" right="22" bottom="16" left="22"/></padding>

        <!-- Stats Row -->
        <HBox spacing="14">
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="📋" style="-fx-font-size:22px;"/>
                <Label text="TOTAL" styleClass="back-stats-label"/>
                <Label fx:id="lblTotalReclamations" text="0" styleClass="back-stats-value"/>
                <Label text="Réclamations" styleClass="back-stats-sub"/>
            </VBox>
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="⏳" style="-fx-font-size:22px;"/>
                <Label text="EN ATTENTE" styleClass="back-stats-label"/>
                <Label fx:id="lblEnAttente" text="0" styleClass="back-stats-value back-stats-value-amber"/>
                <Label text="À traiter" styleClass="back-stats-sub"/>
            </VBox>
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="✅" style="-fx-font-size:22px;"/>
                <Label text="TRAITÉES" styleClass="back-stats-label"/>
                <Label fx:id="lblTraitees" text="0" styleClass="back-stats-value back-stats-value-green"/>
                <Label text="Résolues" styleClass="back-stats-sub"/>
            </VBox>
        </HBox>

        <!-- Toolbar -->
        <HBox styleClass="back-toolbar" alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="txtRecherche" promptText="🔍  Titre, patient ou statut..."
                       prefWidth="250" styleClass="back-search-field"/>
            <Button text="↻ Rafraîchir" onAction="#actualiser" styleClass="back-btn-secondary"/>
            <Button text="📥 Export PDF" onAction="#exporterPDF" styleClass="back-btn-export"/>
            <Button text="📊 Export Excel" onAction="#exporterExcel" styleClass="back-btn-export"/>
            <Button text="💬 Répondre" onAction="#basculerPanneauTraitement" styleClass="back-btn-add"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Toutes les Réponses ➔" onAction="#goToReponses" styleClass="back-btn-secondary" style="-fx-text-fill: #1e40af; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Content: Table + Side Panel -->
        <HBox spacing="16" VBox.vgrow="ALWAYS">

            <!-- Left: Chart + Table -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <VBox styleClass="back-table-card" spacing="0">
                    <PieChart fx:id="chartReclamations" title="Répartition par statut"
                              legendVisible="true" labelsVisible="true" prefHeight="190" minHeight="160"/>
                </VBox>
                <VBox styleClass="back-table-card" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tableReclamation" onMouseClicked="#handleTableClick"
                               VBox.vgrow="ALWAYS" minHeight="260" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="colId"        text="ID"        prefWidth="55"  visible="false"/>
                            <TableColumn fx:id="colTitre"     text="Titre"     prefWidth="220"/>
                            <TableColumn fx:id="colPatient"   text="Patient"   prefWidth="150"/>
                            <TableColumn fx:id="colEmail"     text="Email"     prefWidth="190"/>
                            <TableColumn fx:id="colStatut"    text="Statut"    prefWidth="120"/>
                            <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="120"/>
                            <TableColumn fx:id="colPriorite"  text="Priorité"  prefWidth="100"/>
                            <TableColumn fx:id="colEtatMental" text="État Mental" prefWidth="120"/>
                            <TableColumn fx:id="colDate"      text="Date"      prefWidth="165"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- Right: Treatment Panel -->
            <VBox fx:id="pnlTraitement" spacing="14" prefWidth="440" minWidth="400"
                  visible="false" managed="false"
                  styleClass="back-table-card" style="-fx-padding: 18;">
                <Label text="🛠  Traitement de la réclamation"
                       style="-fx-font-size:15px;-fx-font-weight:800;-fx-text-fill:#0f172a;"/>
                <Separator/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:transparent;-fx-border-color:transparent;">
                    <VBox spacing="10">
                        <padding><Insets right="6" top="4" bottom="4"/></padding>

                        <Label text="Titre" styleClass="form-label"/>
                        <TextField fx:id="txtTitre" editable="false" styleClass="form-field readonly"/>

                        <HBox spacing="10">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Patient" styleClass="form-label"/>
                                <TextField fx:id="txtPatient" editable="false" styleClass="form-field readonly"/>
                            </VBox>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Email" styleClass="form-label"/>
                                <TextField fx:id="txtEmail" editable="false" styleClass="form-field readonly"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Catégorie" styleClass="form-label"/>
                                <ComboBox fx:id="cmbCategorie" disable="true" maxWidth="Infinity" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Priorité" styleClass="form-label"/>
                                <ComboBox fx:id="cmbPriorite" disable="true" maxWidth="Infinity" styleClass="form-field"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Statut" styleClass="form-label"/>
                                <ComboBox fx:id="cmbStatut" promptText="Choisir un statut" maxWidth="Infinity" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="État Mental (Pred.)" styleClass="form-label" style="-fx-text-fill:#dc2626;"/>
                                <TextField fx:id="txtEtatMental" editable="false" styleClass="form-field readonly"
                                           style="-fx-text-fill:#dc2626;-fx-font-weight:bold;"/>
                            </VBox>
                        </HBox>

                        <Label text="Description patient" styleClass="form-label"/>
                        <TextArea fx:id="txtDescription" editable="false" wrapText="true" prefRowCount="3" styleClass="form-field readonly"/>

                        <Label text="Réponse admin" styleClass="form-label"
                               style="-fx-text-fill:#6366f1;-fx-font-weight:800;"/>
                        <TextArea fx:id="txtReponse" wrapText="true" prefRowCount="3" styleClass="form-field" promptText="Saisir une réponse..."/>

                        <HBox spacing="10">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Nom Admin" styleClass="form-label"/>
                                <TextField fx:id="txtAdminNom" promptText="Nom complet" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Email Admin" styleClass="form-label"/>
                                <TextField fx:id="txtAdminEmail" promptText="admin@hospismart.com" styleClass="form-field"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <Separator/>
                <HBox spacing="8">
                    <Button text="💾 Enregistrer"       onAction="#modifierReclamation"  styleClass="back-btn-add"      HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="🗑 Suppr. Réponse"     onAction="#supprimerReponse"     styleClass="back-btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="🗑 Suppr. Réclamation" onAction="#supprimerReclamation" styleClass="back-btn-danger"    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</VBox>
