<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="back-main" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.ReclamationBackController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Title Row -->
    <VBox spacing="5">
        <Label text="Gestion des Réclamations" styleClass="back-page-title" />
        <Label text="Consultez et répondez aux réclamations des patients." styleClass="back-page-subtitle" />
    </VBox>
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="notifIcon" text="🔔" style="-fx-font-size: 20px; -fx-cursor: hand; -fx-text-fill: #1e293b;" onMouseClicked="#handleNotifClick"/>
    </HBox>

            <HBox spacing="18" style="-fx-padding: 12 18 8 18; -fx-background-color: #f7f9fc; -fx-border-color: #dbe3ed; -fx-border-width: 0 0 1 0;">
                <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #dbe3ed; -fx-border-radius: 8;">
                    <Label text="Total:" style="-fx-text-fill: #6b7785; -fx-font-size: 13px;"/>
                    <Label fx:id="lblTotalReclamations" text="0" style="-fx-text-fill: #2f6ecf; -fx-font-size: 16px; -fx-font-weight: 800;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #dbe3ed; -fx-border-radius: 8;">
                    <Label text="En attente:" style="-fx-text-fill: #6b7785; -fx-font-size: 13px;"/>
                    <Label fx:id="lblEnAttente" text="0" style="-fx-text-fill: #d58c1f; -fx-font-size: 16px; -fx-font-weight: 800;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #dbe3ed; -fx-border-radius: 8;">
                    <Label text="Traitees:" style="-fx-text-fill: #6b7785; -fx-font-size: 13px;"/>
                    <Label fx:id="lblTraitees" text="0" style="-fx-text-fill: #2e9b5f; -fx-font-size: 16px; -fx-font-weight: 800;"/>
                </HBox>
            </HBox>

            <HBox styleClass="action-bar" alignment="CENTER_LEFT" spacing="15">
                <Label text="Recherche:" style="-fx-font-weight: 700; -fx-text-fill: #5a6b7f;"/>
                <TextField fx:id="txtRecherche" promptText="Titre, patient ou statut..." prefWidth="240" styleClass="text-input" prefHeight="35.0"/>
                <Button text="↻ Rafraichir" prefHeight="35.0" onAction="#actualiser" styleClass="btn-secondary"/>
                <Button text="📥 Exporter PDF" prefHeight="35.0" onAction="#exporterPDF" styleClass="btn-tertiary"/>
                <Button text="📊 Exporter Excel" prefHeight="35.0" onAction="#exporterExcel" styleClass="btn-add-green"/>
                <Button text="💬 Répondre" prefHeight="35.0" onAction="#basculerPanneauTraitement" styleClass="btn-primary"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS" style="-fx-padding: 18;">
                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding: 12; -fx-background-radius: 5;">
                    <PieChart fx:id="chartReclamations" title="Repartition par statut" legendVisible="true" labelsVisible="true" prefHeight="180" minHeight="160"/>
                    <TableView fx:id="tableReclamation" onMouseClicked="#handleTableClick" VBox.vgrow="ALWAYS" minHeight="300" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="55" visible="false"/>
                            <TableColumn fx:id="colTitre" text="Titre" prefWidth="220"/>
                            <TableColumn fx:id="colPatient" text="Patient" prefWidth="150"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="190"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                            <TableColumn fx:id="colCategorie" text="Categorie" prefWidth="120"/>
                            <TableColumn fx:id="colPriorite" text="Priorite" prefWidth="100"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="165"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox fx:id="pnlTraitement" spacing="12" prefWidth="430" minWidth="400" visible="false" managed="false" styleClass="card" style="-fx-padding: 16; -fx-background-radius: 5;">
                    <Label text="🛠 Traitement de la reclamation" styleClass="card-title" style="-fx-padding: 0;"/>
                    <Separator/>

                    <ScrollPane fitToWidth="true" styleClass="form-scrollpane" VBox.vgrow="ALWAYS">
                        <VBox spacing="10">
                            <padding><Insets right="6" top="4" bottom="4"/></padding>

                            <Label text="Titre" styleClass="form-label"/>
                            <TextField fx:id="txtTitre" editable="false" styleClass="form-field readonly"/>

                            <HBox spacing="10">
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Patient" styleClass="form-label"/>
                                    <TextField fx:id="txtPatient" editable="false" styleClass="form-field readonly"/>
                                </VBox>
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Email" styleClass="form-label"/>
                                    <TextField fx:id="txtEmail" editable="false" styleClass="form-field readonly"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10">
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Categorie" styleClass="form-label"/>
                                    <ComboBox fx:id="cmbCategorie" disable="true" maxWidth="Infinity" styleClass="form-field"/>
                                </VBox>
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Priorite" styleClass="form-label"/>
                                    <ComboBox fx:id="cmbPriorite" disable="true" maxWidth="Infinity" styleClass="form-field"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10">
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Statut" styleClass="form-label"/>
                                    <ComboBox fx:id="cmbStatut" promptText="Choisir un statut" maxWidth="Infinity" styleClass="form-field"/>
                                </VBox>
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Etat Mental (Pred.)" styleClass="form-label" style="-fx-text-fill: #d32f2f;"/>
                                    <TextField fx:id="txtEtatMental" editable="false" styleClass="form-field readonly" style="-fx-text-fill: #d32f2f; -fx-font-weight: bold;"/>
                                </VBox>
                            </HBox>

                            <Label text="Description client" styleClass="form-label"/>
                            <TextArea fx:id="txtDescription" editable="false" wrapText="true" prefRowCount="3" styleClass="form-field readonly"/>

                            <Label text="Reponse admin" styleClass="form-label response-label"/>
                            <TextArea fx:id="txtReponse" wrapText="true" prefRowCount="3" styleClass="form-field" promptText="Saisir une reponse..."/>

                            <HBox spacing="10">
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Nom Admin" styleClass="form-label"/>
                                    <TextField fx:id="txtAdminNom" promptText="Nom complet" styleClass="form-field"/>
                                </VBox>
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <Label text="Email Admin" styleClass="form-label"/>
                                    <TextField fx:id="txtAdminEmail" promptText="admin@hospismart.com" styleClass="form-field"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </ScrollPane>

                    <Separator/>
                    <HBox spacing="8">
                        <Button text="💾 Enregistrer" onAction="#modifierReclamation" styleClass="btn-action-add" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="🗑 Suppr. Reponse" onAction="#supprimerReponse" styleClass="btn-action-update" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="🗑 Suppr. Reclamation" onAction="#supprimerReclamation" styleClass="btn-action-delete" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>
            </HBox>

</VBox>

