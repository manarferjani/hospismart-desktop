<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hospismart.hospismartdesktop.controllers.CategorieController"
      stylesheets="/css/style.css"
      style="-fx-background-color: #f8fafc;">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

    <!-- HEADER -->
    <HBox styleClass="page-header-purple" alignment="CENTER_LEFT" spacing="12">
        <Label text="🏷️  Catégories de Médicaments" styleClass="page-header-title"/>
    </HBox>

    <!-- ── BARRE STATS ───────────────────────────────────────────── -->
    <HBox spacing="12">
        <VBox alignment="CENTER" spacing="3"
              style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10 24;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),6,0,0,2);" HBox.hgrow="ALWAYS">
            <Label text="CATÉGORIES" style="-fx-text-fill:#94a3b8;-fx-font-size:10px;-fx-font-weight:bold;"/>
            <Label fx:id="lblStatTotal" text="—"
                   style="-fx-text-fill:#1e293b;-fx-font-size:22px;-fx-font-weight:bold;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="3"
              style="-fx-background-color:#ede9fe;-fx-background-radius:10;-fx-padding:10 24;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),6,0,0,2);" HBox.hgrow="ALWAYS">
            <Label text="CONSEIL" style="-fx-text-fill:#5b21b6;-fx-font-size:10px;-fx-font-weight:bold;"/>
            <Label text="Chaque médicament est lié à une catégorie"
                   style="-fx-text-fill:#6d28d9;-fx-font-size:11px;"/>
        </VBox>
    </HBox>

    <!-- ── BARRE OUTILS ───────────────────────────────────────────── -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="➕  Nouvelle Catégorie"
                onAction="#handleShowAddDialog"
                style="-fx-background-color:#198754;-fx-text-fill:white;-fx-font-weight:bold;
                       -fx-background-radius:22;-fx-padding:8 18;-fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(25,135,84,0.3),6,0,0,2);"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtSearch" promptText="🔍  Rechercher une catégorie..."
                   prefWidth="240"
                   style="-fx-background-radius:20;-fx-border-radius:20;-fx-border-color:#cbd5e1;
                          -fx-background-color:#f1f5f9;-fx-padding:6 14;"/>
        <Button text="🔄" onAction="#handleRefresh"
                style="-fx-background-color:#e2e8f0;-fx-text-fill:#475569;
                       -fx-background-radius:20;-fx-padding:8 14;-fx-cursor:hand;"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="categorieTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colNom"         text="Nom"         prefWidth="240" sortable="true"/>
            <TableColumn fx:id="colDescription" text="Description"  prefWidth="420" sortable="true"/>
        </columns>
        <placeholder><Label text="Aucune catégorie. Cliquez sur ➕ Nouvelle pour commencer."
                            style="-fx-text-fill:#94a3b8;"/></placeholder>
    </TableView>

    <!-- STATUS -->
    <Label fx:id="lblStatus" styleClass="status-label"/>
</VBox>
