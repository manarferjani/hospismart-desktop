<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospismart.hospismartdesktop.controllers.EvenementStatsController"
      spacing="0"
      style="-fx-background-color:#EEF2F7;">

    <!-- ── Header ──────────────────────────────────────────── -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color:linear-gradient(to right, #1a2332, #2C3E50);
                 -fx-padding: 16 28;">
        <Label text="📊" style="-fx-font-size:22px;"/>
        <Label text="Tableau de Bord — Événements"
               style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="← Retour" onAction="#onRetour" styleClass="btn-retour"/>
    </HBox>

    <!-- ── Scrollable Content ──────────────────────────────── -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
        <VBox spacing="20" style="-fx-background-color:#EEF2F7;">
            <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>

            <!-- ── Stats Cards Row ─────────────────────────── -->
            <FlowPane fx:id="statsCardsPane" hgap="16" vgap="16"/>

            <!-- ── Charts Row ──────────────────────────────── -->
            <HBox spacing="20">
                <!-- Pie Chart -->
                <VBox styleClass="form-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Répartition par Type" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1e293b;"/>
                    <PieChart fx:id="typePieChart" prefHeight="260" legendVisible="true"/>
                </VBox>

                <!-- Bar Chart -->
                <VBox styleClass="form-card" HBox.hgrow="ALWAYS" spacing="8">
                    <Label text="Tendance Mensuelle (6 mois)" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1e293b;"/>
                    <BarChart fx:id="monthlyBarChart" prefHeight="260" legendVisible="false">
                        <xAxis><CategoryAxis label="Mois"/></xAxis>
                        <yAxis><NumberAxis label="Événements"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- ── AI Insights ─────────────────────────────── -->
            <VBox styleClass="form-card" spacing="10">
                <Label text="🤖 Analyses IA" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1e293b;"/>
                <VBox fx:id="insightsContainer" spacing="8"/>
            </VBox>

            <!-- ── Budget by Type ──────────────────────────── -->
            <VBox styleClass="form-card" spacing="10">
                <Label text="💰 Analyse Budgétaire par Type" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1e293b;"/>
                <VBox fx:id="budgetContainer" spacing="6"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
