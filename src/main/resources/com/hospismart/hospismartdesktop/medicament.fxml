<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hospismart.hospismartdesktop.controllers.MedicamentController"
      stylesheets="/css/style.css"
      styleClass="back-page-root">

    <!-- ── TOP BAR ──────────────────────────────────────────────── -->
    <HBox styleClass="back-topbar" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="💊  Médicaments" styleClass="back-topbar-title"/>
            <Label text="Gestion du stock de médicaments" styleClass="back-topbar-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblAlerte" styleClass="back-notif-badge"/>
    </HBox>

    <!-- ── BODY ─────────────────────────────────────────────────── -->
    <VBox spacing="16" VBox.vgrow="ALWAYS" styleClass="back-page-body">
        <padding><Insets top="20" right="22" bottom="16" left="22"/></padding>

        <!-- Stats -->
        <HBox spacing="14">
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="💊" style="-fx-font-size:22px;"/>
                <Label text="MÉDICAMENTS" styleClass="back-stats-label"/>
                <Label fx:id="lblStatTotal" text="—" styleClass="back-stats-value"/>
                <Label text="Total en base" styleClass="back-stats-sub"/>
            </VBox>
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="💰" style="-fx-font-size:22px;"/>
                <Label text="VALEUR DU STOCK" styleClass="back-stats-label"/>
                <Label fx:id="lblStatValeur" text="—" styleClass="back-stats-value back-stats-value-blue"/>
                <Label text="Estimation totale" styleClass="back-stats-sub"/>
            </VBox>
            <VBox styleClass="back-stats-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                <Label text="🤖" style="-fx-font-size:22px;"/>
                <Label text="INTELLIGENCE IA" styleClass="back-stats-label"/>
                <Label text="Prédiction disponible" styleClass="back-stats-value back-stats-value-violet" style="-fx-font-size:13px;"/>
                <Label text="Seuil de commande" styleClass="back-stats-sub"/>
            </VBox>
        </HBox>

        <!-- Toolbar -->
        <HBox styleClass="back-toolbar" spacing="10" alignment="CENTER_LEFT">
            <Button text="➕  Nouveau" onAction="#handleShowAddDialog" styleClass="back-btn-add"/>
            <Button text="📥  Export CSV" onAction="#handleExportCSV" styleClass="back-btn-export"/>
            <Button text="🧠  Prédiction IA" onAction="#handlePrediction" styleClass="back-btn-ai"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cbFilterCategorie" prefWidth="175" styleClass="back-combo" promptText="Catégorie..."/>
            <ComboBox fx:id="cbSortMode" prefWidth="150" promptText="Trier par..." styleClass="back-combo"/>
            <TextField fx:id="txtSearch" promptText="🔍  Rechercher..." prefWidth="200" styleClass="back-search-field"/>
            <Button text="🔄" onAction="#handleRefresh" styleClass="back-btn-refresh"/>
        </HBox>

        <!-- Table -->
        <VBox styleClass="back-table-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="medicamentTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colNom"       text="Nom"          prefWidth="200" sortable="true"/>
                    <TableColumn fx:id="colQuantite"  text="Quantité"     prefWidth="90"  sortable="true"/>
                    <TableColumn fx:id="colSeuil"     text="Seuil Alerte" prefWidth="110" sortable="true"/>
                    <TableColumn fx:id="colPrix"      text="Prix (TND)"   prefWidth="110" sortable="true"/>
                    <TableColumn fx:id="colDate"      text="Péremption"   prefWidth="120" sortable="true"/>
                    <TableColumn fx:id="colCategorie" text="Catégorie"    prefWidth="160" sortable="true"/>
                </columns>
                <placeholder><Label text="Aucun médicament. Cliquez sur ➕ Nouveau pour commencer." style="-fx-text-fill:#94a3b8;"/></placeholder>
            </TableView>
        </VBox>

        <Label fx:id="lblStatus" styleClass="back-status-bar"/>
    </VBox>
</VBox>
