<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hospismart.hospismartdesktop.controllers.MedicamentController"
      stylesheets="@hospismart.css"
      style="-fx-background-color: #f8fafc;">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

    <!-- HEADER -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="💊  Médicaments" styleClass="page-header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblAlerte" style="-fx-text-fill:#fbbf24;-fx-font-weight:bold;-fx-font-size:12px;"/>
    </HBox>

    <!-- ── BARRE STATISTIQUES ─────────────────────────────────────── -->
    <HBox spacing="12">
        <!-- Carte : Total médicaments -->
        <VBox alignment="CENTER" spacing="3"
              style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10 20;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),6,0,0,2);" HBox.hgrow="ALWAYS">
            <Label text="MÉDICAMENTS" style="-fx-text-fill:#94a3b8;-fx-font-size:10px;-fx-font-weight:bold;"/>
            <Label fx:id="lblStatTotal" text="—"
                   style="-fx-text-fill:#1e293b;-fx-font-size:18px;-fx-font-weight:bold;"/>
        </VBox>
        <!-- Carte : Valeur stock -->
        <VBox alignment="CENTER" spacing="3"
              style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10 20;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),6,0,0,2);" HBox.hgrow="ALWAYS">
            <Label text="VALEUR DU STOCK" style="-fx-text-fill:#94a3b8;-fx-font-size:10px;-fx-font-weight:bold;"/>
            <Label fx:id="lblStatValeur" text="—"
                   style="-fx-text-fill:#0d6efd;-fx-font-size:15px;-fx-font-weight:bold;"/>
        </VBox>
    </HBox>

    <!-- ── BARRE OUTILS ───────────────────────────────────────────── -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="➕  Nouveau"
                onAction="#handleShowAddDialog"
                style="-fx-background-color:#198754;-fx-text-fill:white;-fx-font-weight:bold;
                       -fx-background-radius:22;-fx-padding:8 18;-fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(25,135,84,0.3),6,0,0,2);"/>
        <Button text="📥  Export CSV"
                onAction="#handleExportCSV"
                style="-fx-background-color:#0d6efd;-fx-text-fill:white;-fx-font-weight:bold;
                       -fx-background-radius:22;-fx-padding:8 18;-fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(13,110,253,0.25),6,0,0,2);"/>
        <Button text="🧠  Prédiction IA"
                onAction="#handlePrediction"
                style="-fx-background-color:#7c3aed;-fx-text-fill:white;-fx-font-weight:bold;
                       -fx-background-radius:22;-fx-padding:8 18;-fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(124,58,237,0.3),6,0,0,2);"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Filtre catégorie -->
        <ComboBox fx:id="cbFilterCategorie" prefWidth="175"
                  style="-fx-background-radius:20;-fx-border-radius:20;-fx-border-color:#cbd5e1;
                         -fx-background-color:#f1f5f9;-fx-padding:4 10;"/>
        <ComboBox fx:id="cbSortMode" prefWidth="150" promptText="Trier par..."
                  style="-fx-background-radius:20;-fx-border-radius:20;-fx-border-color:#cbd5e1;
                         -fx-background-color:#f1f5f9;-fx-padding:4 10;"/>
        <TextField fx:id="txtSearch" promptText="🔍  Rechercher..."
                   prefWidth="190"
                   style="-fx-background-radius:20;-fx-border-radius:20;-fx-border-color:#cbd5e1;
                          -fx-background-color:#f1f5f9;-fx-padding:6 14;"/>
        <Button text="🔄" onAction="#handleRefresh"
                style="-fx-background-color:#e2e8f0;-fx-text-fill:#475569;-fx-background-radius:20;
                       -fx-padding:8 14;-fx-cursor:hand;"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="medicamentTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colNom"       text="Nom"          prefWidth="180" sortable="true"/>
            <TableColumn fx:id="colQuantite"  text="Quantité"     prefWidth="90"  sortable="true"/>
            <TableColumn fx:id="colSeuil"     text="Seuil Alerte" prefWidth="105" sortable="true"/>
            <TableColumn fx:id="colPrix"      text="Prix (TND)"   prefWidth="100" sortable="true"/>
            <TableColumn fx:id="colDate"      text="Péremption"   prefWidth="110" sortable="true"/>
            <TableColumn fx:id="colCategorie" text="Catégorie"    prefWidth="140" sortable="true"/>
        </columns>
        <placeholder><Label text="Aucun médicament. Cliquez sur ➕ Nouveau pour commencer."
                            style="-fx-text-fill:#94a3b8;"/></placeholder>
    </TableView>

    <!-- STATUS -->
    <Label fx:id="lblStatus" styleClass="status-label"/>
</VBox>
