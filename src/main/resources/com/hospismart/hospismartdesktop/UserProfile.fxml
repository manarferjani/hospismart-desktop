<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: #f4f7f9;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.UserProfileController">
    <!-- Navbar globale -->
    <top>
        <fx:include source="/Navbar.fxml" />
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 40;">
            <!-- Conteneur principal de type carte -->
            <VBox maxWidth="700" spacing="25" styleClass="card-pane" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                
                <!-- Titre -->
                <VBox spacing="5">
                    <Label text="Mon Profil" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #152536;" />
                    <Label text="Gérez vos informations personnelles et paramètres de sécurité" style="-fx-font-size: 14px; -fx-text-fill: #6e7a89;" />
                </VBox>

                <Separator />

                <!-- Formulaire (GridPane pour un alignement parfait) -->
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label text="Nom :" style="-fx-font-weight: bold; -fx-text-fill: #152536;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="nomField" prefHeight="40.0" promptText="Votre nom" styleClass="text-input" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Prénom :" style="-fx-font-weight: bold; -fx-text-fill: #152536;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="prenomField" prefHeight="40.0" promptText="Votre prénom" styleClass="text-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Email :" style="-fx-font-weight: bold; -fx-text-fill: #152536;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="emailField" prefHeight="40.0" promptText="Votre email" styleClass="text-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Téléphone :" style="-fx-font-weight: bold; -fx-text-fill: #152536;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="telephoneField" prefHeight="40.0" promptText="Votre numéro de téléphone" styleClass="text-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Nouveau MDP :" style="-fx-font-weight: bold; -fx-text-fill: #152536;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="(Laisser vide si inchangé)" styleClass="text-input" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </GridPane>

                <!-- Bouton de mise à jour -->
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button mnemonicParsing="false" onAction="#handleUpdate" prefHeight="45.0" prefWidth="200.0" styleClass="btn-primary" text="Enregistrer les modifications" />
                </HBox>

                <Separator />

                <!-- Section Sécurité & Services -->
                <VBox spacing="15">
                    <Label text="Sécurité &amp; Services Avancés" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #152536;" />
                    
                    <HBox spacing="15">
                        <Button mnemonicParsing="false" onAction="#handleFacialRecognition" prefHeight="45.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #3b82f6; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-font-weight: bold;" text="📷 Face ID" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button mnemonicParsing="false" onAction="#handleTwoFactorAuth" prefHeight="45.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #f59e0b; -fx-border-color: #f59e0b; -fx-border-radius: 8; -fx-font-weight: bold;" text="🔐 Configurer 2FA" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    </HBox>
                    
                    <Button mnemonicParsing="false" onAction="#handleVoiceHealth" prefHeight="50.0" maxWidth="Infinity" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="🎤 Consultation Vocale &amp; IA" />
                </VBox>
                
            </VBox>
        </VBox>
    </center>
</BorderPane>
