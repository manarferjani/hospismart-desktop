<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f4f6f9;" stylesheets="/css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.TwoFactorAuthController">
    <children>
        <!-- Top Navbar -->
        <AnchorPane prefHeight="60.0" styleClass="top-navbar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label layoutX="30.0" layoutY="18.0" styleClass="navbar-title" text="HospiSmart — Sécurité" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <!-- Main Content Centered -->
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
            <children>
                <VBox alignment="CENTER" maxWidth="500.0" prefWidth="500.0" spacing="25.0" styleClass="card-pane" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <children>
                        <!-- Icône 2FA -->
                        <Label style="-fx-font-size: 50;" text="🔐" />

                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label text="Vérification 2FA" textFill="#1565c0">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                                <Label text="Veuillez entrer le code à 6 chiffres généré par votre application Google Authenticator" textAlignment="CENTER" textFill="#666666" wrapText="true">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Champ de saisie du code -->
                        <TextField fx:id="codeField" alignment="CENTER" maxWidth="300.0" prefHeight="60.0" promptText="Entrez le code" style="-fx-font-size: 24; -fx-letter-spacing: 5px; -fx-background-radius: 8; -fx-border-color: #bbdefb; -fx-border-radius: 8;" styleClass="text-input">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </TextField>

                        <!-- Message d'erreur -->
                        <Label fx:id="errorLabel" alignment="CENTER" prefHeight="30.0" textFill="#d32f2f" wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <VBox alignment="CENTER" spacing="15.0">
                            <children>
                                <!-- Bouton de vérification -->
                                <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleVerify" prefHeight="50.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;" styleClass="btn-primary" text="✅ Vérifier le code" />

                                <!-- Lien pour utiliser un code de secours -->
                                <Hyperlink onAction="#handleUseBackupCode" text="Utiliser un code de secours ?" textFill="#1565c0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Hyperlink>

                                <!-- Bouton retour -->
                                <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleCancel" prefHeight="45.0" style="-fx-background-color: #f5f5f5; -fx-text-fill: #424242; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;" text="⬅️ Retour à la connexion" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
