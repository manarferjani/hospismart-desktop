<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospismart.hospismartdesktop.controllers.EvenementFrontController"
      spacing="0" style="-fx-background-color: #f5f7fb;">

    <!-- ══ White Top Navbar ══════════════════════════════════════ -->
    <HBox styleClass="front-navbar">
        <!-- Logo -->
        <StackPane styleClass="front-logo-circle">
            <Label text="H" styleClass="front-logo-letter"/>
        </StackPane>
        <Label text="Hospismart" styleClass="front-navbar-brand"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Nav links -->
        <Label text="Accueil"       styleClass="front-nav-link"/>
        <Label text="Evenements"    styleClass="front-nav-link-active"/>

        <Region prefWidth="20"/>

        <Button text="Mon Compte"   styleClass="btn-mon-compte"/>
        <Region prefWidth="8"/>
        <Button text="Deconnexion"  onAction="#onRetour" styleClass="btn-deconnexion"/>
    </HBox>

    <!-- ══ Search Strip ═════════════════════════════════════════ -->
    <HBox styleClass="front-search-strip">
        <TextField fx:id="searchField"
                   promptText="Rechercher un evenement ou un lieu..."
                   styleClass="front-search-field"
                   HBox.hgrow="ALWAYS"
                   onAction="#onSearch"/>
        <ComboBox fx:id="typeFilter" styleClass="combo-filter" promptText="Type"/>
        <Region prefWidth="4"/>
        <Button text="Rechercher" onAction="#onSearch" styleClass="btn-rechercher"/>
    </HBox>

    <!-- ══ Scrollable Content ═══════════════════════════════════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
        <VBox spacing="6" style="-fx-background-color: #f5f7fb;">
            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <!-- Section header -->
            <Label text="NOS EVENEMENTS" styleClass="front-section-badge"/>
            <Label text="Decouvrez nos evenements" styleClass="front-section-title"/>
            <Label text="Que ce soit pour une formation, une reunion ou une visite, inscrivez-vous facilement."
                   styleClass="front-section-subtitle"/>

            <!-- Stats -->
            <HBox spacing="20" style="-fx-padding: 8 0 12 0;">
                <Label fx:id="totalLabel" text="0 evenements disponibles" styleClass="front-stat-label"/>
            </HBox>

            <!-- Card Grid -->
            <FlowPane fx:id="cardsContainer" hgap="20" vgap="20">
                <padding>
                    <Insets top="0" right="0" bottom="20" left="0"/>
                </padding>
            </FlowPane>

        </VBox>
    </ScrollPane>

</VBox>
