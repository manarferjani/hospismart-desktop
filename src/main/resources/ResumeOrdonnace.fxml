<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<StackPane style="-fx-background-color: #f0f2f5;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="com.hospismart.hospismartdesktop.controllers.ResumeOrdonnaceController">
    <VBox alignment="CENTER" maxWidth="500" spacing="30" style="-fx-background-color: white; -fx-background-radius: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
        <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
        </padding>

        <VBox alignment="CENTER" spacing="15">
            <Label style="-fx-font-size: 80; -fx-text-fill: #10B981;" text="✅" />
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-text-alignment: center;" text="Consultation Terminée !" wrapText="true" />
            <Text fx:id="txtConfirmationMessage" style="-fx-fill: #64748b; -fx-font-size: 16;" text="Le dossier du patient a été mis à jour avec succès." />
        </VBox>

        <VBox spacing="15" style="-fx-padding: 30 0 0 0;">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 14;" text="Actions Prochaines" />

            <Button fx:id="btnPdf" maxWidth="Infinity" onAction="#handlePrintPDF" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-padding: 15; -fx-background-radius: 12; -fx-font-weight: bold; -fx-cursor: hand;" text="📄 Imprimer l'Ordonnance (PDF)" />

            <Button fx:id="btnEmail" maxWidth="Infinity" onAction="#handleSendEmail" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-padding: 15; -fx-background-radius: 12; -fx-font-weight: bold; -fx-cursor: hand;" text="📧 Envoyer par Email au Patient" />

            <Region prefHeight="10" />

            <Button maxWidth="Infinity" onAction="#handleBackToDashboard" style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; -fx-text-fill: #64748b; -fx-padding: 12; -fx-background-radius: 12; -fx-cursor: hand;" text="Retour au Tableau de Bord" />
        </VBox>

        <Label fx:id="lblEmailInfo" style="-fx-font-size: 12; -fx-text-fill: #94a3b8;" text="..." />
    </VBox>
</StackPane>