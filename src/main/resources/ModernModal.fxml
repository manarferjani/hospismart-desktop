<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0"
           styleClass="modal-overlay" stylesheets="@css/modals.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hospismart.hospismartdesktop.controllers.ModernModalController">
    <children>
        <VBox alignment="CENTER" fillWidth="false">
            <children>
                <VBox alignment="TOP_CENTER" prefWidth="420.0" spacing="20.0" styleClass="modal-container">
                    <children>
                        <HBox alignment="TOP_RIGHT">
                            <Button fx:id="btnClose" onAction="#closeModal" styleClass="close-x" text="✕" />
                        </HBox>

                        <StackPane fx:id="iconContainer" maxHeight="70.0" maxWidth="70.0">
                            <ImageView fx:id="iconImage" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                        </StackPane>

                        <Label fx:id="lblTitle" styleClass="modal-title" text="Success" />
                        <Label fx:id="lblMessage" alignment="CENTER" styleClass="modal-message" textAlignment="CENTER" wrapText="true" />

                        <VBox alignment="CENTER" spacing="12.0">
                            <Button fx:id="btnPrimary" onAction="#onPrimaryAction" prefHeight="45.0" prefWidth="100" styleClass="button-primary" text="OK" />
                            <Button fx:id="btnSecondary" onAction="#closeModal" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: transparent; -fx-text-fill: #6b7280;" text="Cancel" visible="false" />
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>