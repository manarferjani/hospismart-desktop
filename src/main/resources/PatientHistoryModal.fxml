<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospismart.hospismartdesktop.controllers.PatientHistoryModalController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <Label fx:id="lblPatientName" text="Historique : " styleClass="header-title" />
    <Label text="Liste de toutes les consultations avec vous." styleClass="text-muted" />

    <TableView fx:id="tableHistory" prefHeight="300" prefWidth="600" styleClass="modern-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colDate" text="Date et Heure" prefWidth="150" />
            <TableColumn fx:id="colMotif" text="Motif de Consultation" prefWidth="250" />
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="150" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10" VBox.vgrow="NEVER">
        <Button text="Fermer" onAction="#handleClose" styleClass="btn-outline-danger" />
    </HBox>
</VBox>
